FROM registry.redhat.io/ubi8/go-toolset:1.25 AS build

USER root
RUN dnf install -y --setopt=tsflags=nodocs git

COPY . /go/src/

RUN sed -i 's/CGO_ENABLED=0 /CGO_ENABLED=1 /;s/containers_image_openpgp/& strictfipsruntime/' /go/src/Makefile
RUN cd /go/src/ && make build

FROM registry.redhat.io/ubi8/podman

LABEL com.redhat.component="quay-builder-container"
LABEL name="quay/quay-builder-rhel8"
LABEL io.k8s.display-name="Red Hat Quay - Builder"
LABEL io.k8s.description="Red Hat Quay image builder"
LABEL io.openshift.tags="quay"
LABEL summary="Red Hat Quay image builder"
LABEL description="Red Hat Quay image builder"
LABEL vendor="Red Hat, Inc."
LABEL maintainer="quay-devel@redhat.com"

# Exclude glibc* from update: ubi8/podman base image ships glibc-minimal-langpack
# with an exact version pin on glibc. Updating glibc without also updating the
# langpack causes a dependency conflict (glibc .43 vs langpack requiring .40).
RUN set -ex\
	; dnf update -y --setopt=tsflags=nodocs --exclude=glibc* \
	; dnf install -y --setopt=tsflags=nodocs --setopt=skip_missing_names_on_install=False git wget \
	; dnf -y -q clean all

COPY --from=build /go/src/bin/quay-builder /usr/local/bin
COPY buildpack/ssh-git.sh /
COPY entrypoint.sh /home/podman/entrypoint.sh

RUN touch /etc/subgid /etc/subuid && \
    chmod g=u /etc/subgid /etc/subuid /etc/passwd && \
    echo 'podman:100000:65536' > /etc/subuid && echo 'podman:100000:65536' > /etc/subgid && \
    mkdir -p /home/podman/.config/containers && \
    (echo '[storage]';echo 'driver = "vfs"') > /home/podman/.config/containers/storage.conf && \
    sed -i 's/short-name-mode="enforcing"/short-name-mode="permissive"/g' /etc/containers/registries.conf && \
	mkdir /certs /home/podman/.config/cni && chown podman:podman /certs /home/podman/.config/cni

VOLUME [ "/certs" ]
WORKDIR /home/podman
USER podman
ENTRYPOINT ["sh", "/home/podman/entrypoint.sh"]
